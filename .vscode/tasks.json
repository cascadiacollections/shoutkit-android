{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build FOSS Debug",
      "type": "shell",
      "command": "./gradlew",
      "args": ["assembleFossDebug", "--no-daemon"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Build Play Debug",
      "type": "shell",
      "command": "./gradlew",
      "args": ["assemblePlayDebug", "--no-daemon"],
      "group": "build",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Test (FOSS Debug)",
      "type": "shell",
      "command": "./gradlew",
      "args": ["testFossDebugUnitTest", "--no-daemon"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Verify (CI Baseline)",
      "type": "shell",
      "command": "just",
      "args": ["verify"],
      "group": "test",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Install Debug on Device",
      "type": "shell",
      "command": "just",
      "args": ["install"],
      "group": "build",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Lint (Detekt + Android Lint)",
      "type": "shell",
      "command": "just",
      "args": ["lint"],
      "group": "test",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Format (ktlint auto-correct)",
      "type": "shell",
      "command": "just",
      "args": ["format"],
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Coverage Report",
      "type": "shell",
      "command": "./gradlew",
      "args": ["jacocoTestReport", "--no-daemon"],
      "group": "test",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "./gradlew",
      "args": ["clean", "--no-daemon"],
      "problemMatcher": []
    }
  ]
}
